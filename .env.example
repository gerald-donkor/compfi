# Local development may omit these to use data/compfi.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Server-only Flutterwave credentials.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Server-only Resend configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Public canonical origin used for payment callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
